Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Preserve bearer tokens when Apache rewrites requests to api/index.php.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^uploads/.*\.(php|phtml|phar|cgi|pl|py|sh)$ - [F,NC,L]
RewriteRule ^api(?:/.*)?$ api/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<FilesMatch "^(\.env|config\.local\.php|composer\.(json|lock)|.*\.sql|install\.lock)$">
Require all denied
</FilesMatch>

<Files "config.php">
Require all denied
</Files>

# BEGIN MilesWeb-ErrorPages
ErrorDocument 503 /error_pages/503.html
# END MilesWeb-ErrorPages
<Files "ai-settings.local.php">
    Require all denied
</Files>
